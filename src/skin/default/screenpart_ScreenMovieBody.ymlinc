- eLabel:
    backgroundColor: "md_outline_variant"
    position: "$width-480-15,60"
    size: "1,$height-60"
    zPosition: "-5"
- widget:
    font: "$md_title_large"
    foregroundColor: "md_key_yellow"
    name: "searchinfo"
    position: "0,0"
    size: "$width,45"
    transparent: "1"
- widget:
    font: "$md_body_small"
    name: "fulldescription"
    position: "0,60"
    scrollbarMode: "showNever"
    size: "850,$height-95"
    transparent: "1"
- widget:
    addon: "COCPager"
    backgroundColor: "md_surface"
    conditional: "fulldescription"
    connection: "fulldescription"
    position: "0,$height-25"
    size: "850,25"
    transparent: "1"
- widget:
    alphatest: "blend"
    cornerRadius: "$radius_poster_large"
    name: "cover"
    position: "$width-480,60"
    scale: "1"
    size: "480,720"
- xmlinc:
    file: "screenpart_MovieDetails.ymlinc"
    position: "875,190"
