screen:
  name: "ScreenSeason"
  position: "0,0"
  size: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        name: "backdrop"
        position: "0,0"
        scale: "1"
        size: "1920,1080"
        zPosition: "-1"
    - widget:
        font: "$md_headline_small"
        foregroundColor: "md_key_yellow"
        name: "searchinfo"
        position: "30,75"
        size: "1860,45"
        transparent: "1"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "30,135"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1310,520"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContentEx"
              cell:
                itemHeight: 40
                fonts:
                  - "$md_body_small"
                fields:
                  - text:
                      position: "10,0"
                      size: "e-20,40"
                      font: "$md_body_small"
                      flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                      value: 0
    - xmlinc:
        file: "screenpart_ListPager.ymlinc"
        connection: "list"
        position: "30,655"
        width: "1310"
    - widget:
        cornerRadius: "$radius_poster"
        name: "cover"
        position: "1370,135"
        scaleFlags: "scaleCenter"
        size: "520,520"
    - widget:
        font: "$md_body_small"
        name: "overview"
        position: "30,680"
        size: "1860,330"
        transparent: "1"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
