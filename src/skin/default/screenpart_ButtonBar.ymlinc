- xmlinc:
    color: "keyRed"
    file: "screenpart_1CockpitButton.ymlinc"
    key: "key_red"
    name: "key_red"
    position: "0,0"
    width: "($screen_width-180)/$4"
- xmlinc:
    color: "keyGreen"
    file: "screenpart_1CockpitButton.ymlinc"
    key: "key_green"
    name: "key_green"
    position: "($screen_width-180)/$4,0"
    width: "($screen_width-180)/$4"
- xmlinc:
    color: "keyYellow"
    file: "screenpart_1CockpitButton.ymlinc"
    key: "key_yellow"
    name: "key_yellow"
    position: "$2*($screen_width-180)/$4,0"
    width: "($screen_width-180)/$4"
- xmlinc:
    color: "keyBlue"
    file: "screenpart_1CockpitButton.ymlinc"
    key: "key_blue"
    name: "key_blue"
    position: "$3*($screen_width-180)/$4,0"
    width: "($screen_width-180)/$4"
- xmlinc:
    color: "white"
    file: "screenpart_1CockpitButton.ymlinc"
    key: "key_menu"
    name: "key_menu"
    position: "$screen_width-180,0"
    width: "90"
- xmlinc:
    color: "white"
    file: "screenpart_1CockpitButton.ymlinc"
    key: "key_info"
    name: "key_info"
    position: "$screen_width-90,0"
    width: "90"
