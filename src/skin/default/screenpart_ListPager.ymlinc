widget:
  addon: "Pager"
  connection: "$connection"
  foregroundColor: "md_on_surface"
  picL: "/usr/lib/enigma2/python/Plugins/Extensions/%PLUGIN%/skin/images/shevronleft.png"
  picPage: "/usr/lib/enigma2/python/Plugins/Extensions/%PLUGIN%/skin/images/dot.png"
  picPageCurrent: "/usr/lib/enigma2/python/Plugins/Extensions/%PLUGIN%/skin/images/dotfull.png"
  picR: "/usr/lib/enigma2/python/Plugins/Extensions/%PLUGIN%/skin/images/shevronright.png"
  position: "0,0"
  size: "$width,25"
  transparent: "1"
