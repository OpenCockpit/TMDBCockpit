screen:
  name: "ScreenMain"
  position: "0,0"
  size: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        name: "backdrop"
        position: "0,0"
        scale: "1"
        size: "1920,1080"
        zPosition: "-1"
    - widget:
        font: "$md_headline_small"
        foregroundColor: "md_key_yellow"
        name: "searchinfo"
        position: "30,75"
        size: "1860,45"
        transparent: "1"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "30,135"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1350,840"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContentEx"
              cell:
                itemHeight: 40
                fonts:
                  - "$md_body_small"
                fields:
                  - text:
                      position: "10,0"
                      size: "e-20,40"
                      font: "$md_body_small"
                      flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                      value: 0
    - widget:
        cornerRadius: "$radius_poster"
        name: "cover"
        position: "1410,135"
        scale: "1"
        size: "480,720"
    - ePixmap:
        alphatest: "blend"
        pixmap: "~/../images/tmdb.png"
        position: "1475,880"
        scale: "1"
        size: "350,30"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
