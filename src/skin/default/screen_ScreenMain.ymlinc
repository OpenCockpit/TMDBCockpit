screen:
  backgroundColor: "md_transparent"
  name: "ScreenMain"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - widget:
        cornerRadius: "$radius_window_inner"
        name: "backdrop"
        position: "2,72"
        scale: "1"
        size: "1908,927"
        zPosition: "-1"
    - widget:
        font: "$md_title_large"
        foregroundColor: "md_key_yellow"
        name: "searchinfo"
        position: "30,75"
        size: "1860,45"
        transparent: "1"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "30,135"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1350,810"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "COCTemplatedMultiContentEx"
              cell:
                itemHeight: 45
                fonts:
                  - "$md_body_large"
                fields:
                  - text:
                      position: "10,0"
                      size: "e-20,45"
                      font: "$md_body_large"
                      flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                      value: 0
    - widget:
        cornerRadius: "$radius_poster_large"
        name: "cover"
        position: "1410,135"
        scale: "1"
        size: "480,720"
    - ePixmap:
        alphatest: "blend"
        pixmap: "~/../images/tmdb.png"
        position: "1475,880"
        scale: "1"
        size: "350,30"
