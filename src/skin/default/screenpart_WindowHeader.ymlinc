- xmlinc:
    file: "screenpart_Clock.ymlinc"
    position: "$width-$window_inset_x-120,2"
    size: "120,$window_header_height-2"
    clock_background: "md_surface_container_low"
    clock_font: "$md_headline_small_emphasized"
- eLabel:
    backgroundColor: "md_surface_container_high"
    position: "$window_inset_x,3"
    size: "$width-2*$window_inset_x-120,$window_header_height-2"
    zPosition: "19"
- widget:
    addon: "ScreenHeader"
    connection: "Image,Title,ScreenPath"
    position: "$window_inset_x,2"
    size: "$width-2*$window_inset_x-120,$window_header_height-2"
