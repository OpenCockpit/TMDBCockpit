- eLabel:
    backgroundColor: "md_surface_container_high"
    position: "0,0"
    size: "$screen_width,55"
- widget:
    font: "$md_headline_large_emphasized"
    foregroundColor: "md_primary"
    position: "10,0"
    render: "Label"
    size: "$screen_width-20,55"
    source: "Title"
    transparent: "1"
    valign: "center"
    zPosition: "1"
- eLabel:
    backgroundColor: "md_outline_variant"
    position: "0,54"
    size: "$screen_width,2"
