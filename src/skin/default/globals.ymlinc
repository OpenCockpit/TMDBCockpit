- xmlinc:
    file: "colors.ymlinc"
- xmlinc:
    file: "fonts.ymlinc"
- xmlinc:
    file: "radii.ymlinc"
- xmlinc:
    file: "frames.ymlinc"
- xmlinc:
    file: "lists.ymlinc"
- xmlinc:
    file: "defaults.ymlinc"

# symbolic colors: the selected entry of a list is the inverse selection of Google TV (light grey, with dark blue text)
- global:
    name: "backgroundColorSelected"
    value: "md_inverse_surface"
- global:
    name: "foregroundColorSelected"
    value: "md_inverse_on_surface"

# the key icons of the button bar (screenpart_ButtonsBar); MaterialSkinCockpit has them in its own skin directory
- global:
    name: "buttons_dir"
    value: "/usr/lib/enigma2/python/Plugins/Extensions/%PLUGIN%/skin/images/buttons"

# the size of a dialog window (screenpart_Window): the screens that include it pass their own (dialog_width,
# dialog_height attributes of the include); these are the ones the part is drawn with on its own (the preview of the part)
- global:
    name: "dialog_width"
    value: "1200"
- global:
    name: "dialog_height"
    value: "430"

# screen sizes
- global:
    name: "title_height"
    value: "55"
- global:
    name: "footer_height"
    value: "55"
