# The fonts of the Cockpit plugins are registered system wide by FontsCockpit (Roboto Regular as "Roboto", Roboto
# Medium as "RobotoMedium"), under names of their own so that no skin's "Regular" or "Medium" is replaced. A plugin
# skin does not define fonts; FontsCockpit is a dependency of the plugins.

# material style font definitions, used as $md_... in the skins (same sizes as MaterialSkinCockpit's aliases)
- global:
    name: "md_label_medium"
    value: "Roboto;20"
- global:
    name: "md_label_large"
    value: "Roboto;22"
- global:
    name: "md_body_small"
    value: "Roboto;26"
- global:
    name: "md_body_medium"
    value: "Roboto;28"
- global:
    name: "md_body_large"
    value: "Roboto;30"
- global:
    name: "md_title_large"
    value: "Roboto;34"
- global:
    name: "md_headline_medium"
    value: "Roboto;40"
- global:
    name: "md_display_small"
    value: "Roboto;50"
- global:
    name: "md_display_large"
    value: "Roboto;108"
- global:
    name: "md_label_small_emphasized"
    value: "RobotoMedium;18"
- global:
    name: "md_title_small_emphasized"
    value: "RobotoMedium;28"
- global:
    name: "md_title_medium_emphasized"
    value: "RobotoMedium;30"
- global:
    name: "md_headline_small_emphasized"
    value: "RobotoMedium;36"
- global:
    name: "md_headline_large_emphasized"
    value: "RobotoMedium;42"
- global:
    name: "md_display_medium_emphasized"
    value: "RobotoMedium;60"
