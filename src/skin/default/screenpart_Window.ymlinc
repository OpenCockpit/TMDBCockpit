screen:
  frame: "true"
  name: "Window"
  children:
    - xmlinc:
        file: "screenpart_WindowBase.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_WindowHeader.ymlinc"
        position: "0,0"
    - xmlinc:
        file: "screenpart_WindowFooter.ymlinc"
        position: "$window_inset_x,$height-68"
        size: "$width-2*$window_inset_x,62"
