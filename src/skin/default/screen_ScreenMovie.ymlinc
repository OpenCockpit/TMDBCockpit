screen:
  backgroundColor: "md_transparent"
  name: "ScreenMovie"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - widget:
        cornerRadius: "$radius_window_inner"
        name: "backdrop"
        position: "2,72"
        scale: "1"
        size: "1908,927"
        zPosition: "-1"
    - widget:
        font: "$md_title_large"
        foregroundColor: "md_key_yellow"
        name: "searchinfo"
        position: "30,75"
        size: "1860,45"
        transparent: "1"
    - widget:
        font: "$md_body_small"
        name: "fulldescription"
        position: "30,135"
        size: "850,840"
        transparent: "1"
    - widget:
        alphatest: "blend"
        cornerRadius: "$radius_poster_large"
        name: "cover"
        position: "1410,135"
        scale: "1"
        size: "480,720"
    - xmlinc:
        file: "screenpart_MovieDetails.ymlinc"
        position: "905,265"
