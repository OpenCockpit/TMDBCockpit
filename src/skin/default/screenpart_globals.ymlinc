- xmlinc:
    file: "colors.ymlinc"
- xmlinc:
    file: "fonts.ymlinc"
- xmlinc:
    file: "screenpart_defaults.ymlinc"

# symbolic colors
- global:
    name: "backgroundColorSelected"
    value: "md_surface_container_high"
- global:
    name: "foregroundColorSelected"
    value: "md_primary"

# corner radius of covers/posters
- global:
    name: "radius_poster"
    value: "12"

# corner radius of the selected list item
- global:
    name: "radius_item"
    value: "8"

# screen sizes
- global:
    name: "title_height"
    value: "55"
- global:
    name: "footer_height"
    value: "55"
