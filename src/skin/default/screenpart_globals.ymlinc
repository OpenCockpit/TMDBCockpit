- xmlinc:
    file: "colors.ymlinc"
- xmlinc:
    file: "fonts.ymlinc"
- xmlinc:
    file: "radii.ymlinc"
- xmlinc:
    file: "frames.ymlinc"
- xmlinc:
    file: "screenpart_defaults.ymlinc"

# symbolic colors
- global:
    name: "backgroundColorSelected"
    value: "md_surface_container_high"
- global:
    name: "foregroundColorSelected"
    value: "md_primary"

# the key icons of the button bar (screenpart_ButtonsBarTemplate); MaterialSkinCockpit has them in its own skin directory
- global:
    name: "buttons_dir"
    value: "/usr/lib/enigma2/python/Plugins/Extensions/%PLUGIN%/skin/images/buttons"

# screen sizes
- global:
    name: "title_height"
    value: "55"
- global:
    name: "footer_height"
    value: "55"
