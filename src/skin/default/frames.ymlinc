# full
- global:
    name: "window_full_width"
    value: "$output_width-8"
- global:
    name: "window_full_height"
    value: "$output_height+11"
- global:
    name: "window_full_padding_x"
    value: "24"
- global:
    name: "window_full_padding_top"
    value: "24"
- global:
