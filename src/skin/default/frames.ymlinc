# The windows of a screen: per frame its size, the padding between the surface of the window and its body, and the
# body rectangle that follows from both. A screen includes screenpart_Window.ymlinc with size="$window_<frame>_width,
# $window_<frame>_height" and its body at "$window_<frame>_body_x,$window_<frame>_body_y" in the size
# "$window_<frame>_body_width,$window_<frame>_body_height".

# what all frames share
- global:
    name: "window_surface_x"
    value: "2"
# the distance of the header and of the footer from the left and from the right edge of the window: the one of the body
# of the frame (window_<frame>_body_x), which every include of screenpart_Window.ymlinc passes as window_inset_x; the
# value here is the one the part is drawn with on its own (the preview of the part)
- global:
    name: "window_inset_x"
    value: "26"
- global:
    name: "window_header_height"
    value: "62"
- global:
    name: "window_footer_height"
    value: "62"
- global:
    name: "window_surface_trim"
    value: "20+$window_header_height+$window_footer_height"
- global:
    name: "window_popup_header_height"
    value: "47"

# small
- global:
    name: "window_small_width"
    value: "932"
- global:
    name: "window_small_height"
    value: "825"
- global:
    name: "window_small_padding_x"
    value: "19"
- global:
    name: "window_small_padding_top"
    value: "24"
- global:
    name: "window_small_padding_bottom"
    value: "5"
- global:
    name: "window_small_body_x"
    value: "$window_surface_x+$window_small_padding_x"
- global:
    name: "window_small_body_y"
    value: "$window_header_height+$window_small_padding_top"
- global:
    name: "window_small_trim_x"
    value: "2*$window_surface_x+2*$window_small_padding_x"
- global:
    name: "window_small_trim_y"
    value: "$window_surface_trim+$window_small_padding_top+$window_small_padding_bottom"
- global:
    name: "window_small_body_width"
    value: "$window_small_width-$window_small_trim_x"
- global:
    name: "window_small_body_height"
    value: "$window_small_height-$window_small_trim_y"

# medium
- global:
    name: "window_medium_width"
    value: "1180"
- global:
    name: "window_medium_height"
    value: "858"
- global:
    name: "window_medium_padding_x"
    value: "24"
- global:
    name: "window_medium_padding_top"
