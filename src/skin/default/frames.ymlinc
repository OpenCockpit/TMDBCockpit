# dialog: the size is the one of the screen (dialog_width, dialog_height of its include), so the body is
# given as an origin and as the amounts it is smaller than the dialog
- global:
    name: "window_dialog_padding_x"
    value: "14"
- global:
    name: "window_dialog_padding_top"
    value: "12"
- global:
    name: "window_dialog_padding_bottom"
    value: "12"
- global:
    name: "window_dialog_body_x"
    value: "$window_surface_x+$window_dialog_padding_x"
- global:
    name: "window_dialog_body_y"
    value: "$window_header_height+$window_dialog_padding_top"
- global:
    name: "window_dialog_trim_x"
    value: "2*$window_surface_x+2*$window_dialog_padding_x"
- global:
    name: "window_dialog_trim_y"
    value: "$window_surface_trim+$window_dialog_padding_top+$window_dialog_padding_bottom"

# the wizard window
- global:
    name: "window_wizard_width"
    value: "1536"
- global:
    name: "window_wizard_height"
    value: "908"
