screen:
  backgroundColor: "panelBG"
  flags: "wfNoBorder"
  name: "ScreenPerson"
  position: "0,0"
  resolution: "1920,1080"
  size: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        name: "backdrop"
        position: "0,0"
        scale: "1"
        size: "1920,1080"
        zPosition: "-1"
    - widget:
        font: "$FB_medium"
        foregroundColor: "keyYellow"
        name: "searchinfo"
        position: "30,75"
        size: "1860,36"
        transparent: "1"
    - widget:
        font: "$FR_small"
        name: "fulldescription"
        position: "30,135"
        size: "1350,840"
        transparent: "1"
    - widget:
        alphatest: "blend"
        name: "cover"
        position: "1410,135"
        scale: "1"
        size: "480,720"
    - xmlinc:
        file: "screenpart_BottomBar.ymlinc"
    - xmlinc:
        file: "screenpart_ButtonBar.ymlinc"
        position: "0,$screen_height-48"
