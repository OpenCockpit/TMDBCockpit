screen:
  frame: "true"
  name: "Window_Full"
  children:
    - eLabel:
        backgroundColor: "md_surface_container_high"
        cornerRadius: "$radius_window"
        position: "0,0"
        size: "$screen_width-8,$screen_height-9"
        zPosition: "-11"
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_window_inner"
        position: "2,72"
        size: "$screen_width-12,$screen_height-153"
        zPosition: "-10"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "24,0"
        size: "$screen_width-56,2"
        zPosition: "-7"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "0,24"
        size: "2,$screen_height-98"
        zPosition: "-7"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        position: "$screen_width-10,24"
        size: "2,$screen_height-98"
        zPosition: "-7"
    - widget:
        addon: "ScreenHeader"
        backgroundColor: "md_surface_container_high"
        connection: "Image,Title,ScreenPath"
        pathFont: "$md_label_small_emphasized"
        pathForegroundColor: "md_primary"
        position: "20,3"
        size: "$screen_width-220,66"
        titleFont: "$md_title_small_emphasized"
        titleForegroundColor: "md_primary"
        titleSingleFont: "$md_headline_large_emphasized"
        transparent: "1"
    - xmlinc:
        file: "screenpart_Clock.ymlinc"
        position: "$screen_width-170,0"
        size: "120,70"
        clock_background: "md_shadow"
        clock_font: "$md_headline_large_emphasized"
    - xmlinc:
        file: "screenpart_ButtonsBarTemplate.ymlinc"
        position: "20,$screen_height-60"
        size: "$screen_width-48,62"
