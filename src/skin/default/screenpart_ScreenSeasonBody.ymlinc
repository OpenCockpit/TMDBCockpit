- widget:
    font: "$md_title_large"
    foregroundColor: "md_key_yellow"
    name: "searchinfo"
    position: "0,0"
    size: "$width,45"
    transparent: "1"
- widget:
    backgroundColorSelected: "$backgroundColorSelected"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "0,60"
    render: "Listbox"
    scrollbarMode: "showOnDemand"
    size: "1310,11*$list_item_height"
    source: "list"
    transparent: "1"
    children:
      - convert:
          type: "COCTemplatedMultiContentEx"
          cell:
            itemHeight: $list_item_height
            fonts:
              - "$md_body_large"
            fields:
              - text:
                  position: "10,0"
                  size: "e-20,45"
                  font: "$md_body_large"
                  flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                  value: 0
- xmlinc:
    file: "screenpart_Pager.ymlinc"
    position: "0,560"
    size: "1310,25"
    connection: "list"
- widget:
    cornerRadius: "$radius_poster_large"
    name: "cover"
    position: "$width-520,60"
    scaleFlags: "scaleCenter"
    size: "520,520"
- widget:
    font: "$md_body_large"
    name: "overview"
    position: "0,$height-315"
    size: "$width,315"
    transparent: "1"
